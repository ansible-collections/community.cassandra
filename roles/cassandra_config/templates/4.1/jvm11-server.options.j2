### CMS Settings
{{ '-XX:+UseConcMarkSweepGC' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:+UseConcMarkSweepGC' }}
{{ '-XX:+CMSParallelRemarkEnabled' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:+CMSParallelRemarkEnabled' }}
{{ '-XX:SurvivorRatio=8' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:SurvivorRatio=8' }}
{{ '-XX:MaxTenuringThreshold=1' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:MaxTenuringThreshold=1' }}
{{ '-XX:CMSInitiatingOccupancyFraction=' ~ (cassandra_jvm11_cms_initiating_occupancy_fraction | default(cassandra_jvm_cms_initiating_occupancy_fraction)) if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:CMSInitiatingOccupancyFraction=75' }}
{{ '-XX:+UseCMSInitiatingOccupancyOnly' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:+UseCMSInitiatingOccupancyOnly' }}
{{ '-XX:CMSWaitDuration=10000' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:CMSWaitDuration=10000' }}
{{ '-XX:+CMSParallelInitialMarkEnabled' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:+CMSParallelInitialMarkEnabled' }}
{{ '-XX:+CMSEdenChunksRecordAlways' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:+CMSEdenChunksRecordAlways' }}
## some JVMs will fill up their heap when accessed via JMX, see CASSANDRA-6541
{{ '-XX:+CMSClassUnloadingEnabled' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'CMS' else '#-XX:+CMSClassUnloadingEnabled' }}



### G1 Settings
## Use the Hotspot garbage-first collector.
{{ '-XX:+UseG1GC' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'G1' else '#-XX:+UseG1GC' }}
{{ '-XX:+ParallelRefProcEnabled' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'G1' else '#-XX:+ParallelRefProcEnabled' }}
{{ '-XX:MaxTenuringThreshold=' ~ (cassandra_jvm11_max_tenuring_threshold | default(cassandra_jvm_max_tenuring_threshold)) if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'G1' else '#-XX:MaxTenuringThreshold=1' }}
{{ '-XX:G1HeapRegionSize=' ~ (cassandra_jvm11_g1_heap_region_size | default(cassandra_jvm_g1_heap_region_size)) if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'G1' else '#-XX:G1HeapRegionSize=16m' }}

#
## Have the JVM do less remembered set work during STW, instead
## preferring concurrent GC. Reduces p99.9 latency.
{{ '-XX:G1RSetUpdatingPauseTimePercent=5' if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'G1' else '#-XX:G1RSetUpdatingPauseTimePercent=5' }}
#
## Main G1GC tunable: lowering the pause target will lower throughput and vise versa.
## 200ms is the JVM default and lowest viable setting
## 1000ms increases throughput. Keep it smaller than the timeouts in cassandra.yaml.
{{ '-XX:MaxGCPauseMillis=' ~ (cassandra_jvm11_max_gc_pause_millis | default(cassandra_jvm_max_gc_pause_millis)) if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'G1' else '#-XX:MaxGCPauseMillis=300' }}

## Optional G1 Settings
# Save CPU time on large (>= 16GB) heaps by delaying region scanning
# until the heap is 70% full. The default in Hotspot 8u40 is 40%.
{{ '-XX:InitiatingHeapOccupancyPercent=' ~ (cassandra_jvm11_initiating_heap_occupancy_percent | default(cassandra_jvm_initiating_heap_occupancy_percent)) if (cassandra_jvm11_gc | default(cassandra_jvm_gc)) == 'G1' else '#-XX:InitiatingHeapOccupancyPercent=70' }}

# For systems with > 8 cores, the default ParallelGCThreads is 5/8 the number of logical cores.
# Otherwise equal to the number of cores when 8 or less.
# Machines with > 10 cores should try setting these to <= full cores.
{{ '' if (cassandra_jvm11_parallel_gc_threads | default(cassandra_jvm_parallel_gc_threads)) else '#' }}-XX:ParallelGCThreads={{ (cassandra_jvm11_parallel_gc_threads | default(cassandra_jvm_parallel_gc_threads)) or '16' }}
# By default, ConcGCThreads is 1/4 of ParallelGCThreads.
# Setting both to the same value can reduce STW durations.
{{ '' if (cassandra_jvm11_conc_gc_threads | default(cassandra_jvm_conc_gc_threads)) else '#' }}-XX:ConcGCThreads={{ (cassandra_jvm11_conc_gc_threads | default(cassandra_jvm_conc_gc_threads)) or '16' }}


